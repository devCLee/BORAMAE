        <!-- Step legend: one group outside AWS Cloud, delete or crop in one move -->
        <mxCell id="legend-group" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="1880" y="130" width="500" height="730" as="geometry" />
        </mxCell>
        <mxCell id="legend-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#EDF3FF,#305363);fillStyle=auto;strokeColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="legend-group">
          <mxGeometry width="500" height="730" as="geometry" />
        </mxCell>
        <mxCell id="legend-title" value="Steps" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=16;fontStyle=1;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);labelBackgroundColor=none;" vertex="1" parent="legend-group">
          <mxGeometry x="20" y="18" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=light-dark(#000000,#FFFFFF);fillStyle=auto;strokeColor=none;fontColor=light-dark(#FFFFFF,#000000);fontStyle=1;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=none;spacing=0;" vertex="1" parent="legend-group">
          <mxGeometry x="20" y="55" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-1" value="The user opens the app on the CloudFront domain. One domain serves the app and the API." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);labelBackgroundColor=none;" vertex="1" parent="legend-group">
          <mxGeometry x="60" y="59" width="420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=light-dark(#000000,#FFFFFF);fillStyle=auto;strokeColor=none;fontColor=light-dark(#FFFFFF,#000000);fontStyle=1;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=none;spacing=0;" vertex="1" parent="legend-group">
          <mxGeometry x="20" y="109" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-2" value="AWS WAF checks each request against managed rule groups and per-IP rate limits." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);labelBackgroundColor=none;" vertex="1" parent="legend-group">
          <mxGeometry x="60" y="113" width="420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=light-dark(#000000,#FFFFFF);fillStyle=auto;strokeColor=none;fontColor=light-dark(#FFFFFF,#000000);fontStyle=1;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=none;spacing=0;" vertex="1" parent="legend-group">
          <mxGeometry x="20" y="163" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-3" value="CloudFront serves the static Next.js export from the private web bucket through origin access control." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);labelBackgroundColor=none;" vertex="1" parent="legend-group">
          <mxGeometry x="60" y="167" width="420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=light-dark(#000000,#FFFFFF);fillStyle=auto;strokeColor=none;fontColor=light-dark(#FFFFFF,#000000);fontStyle=1;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=none;spacing=0;" vertex="1" parent="legend-group">
          <mxGeometry x="20" y="217" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-4" value="CloudFront sends /api/*, /health, /r/* and /meta/* to the API origin and adds a secret origin header." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);labelBackgroundColor=none;" vertex="1" parent="legend-group">
          <mxGeometry x="60" y="221" width="420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=light-dark(#000000,#FFFFFF);fillStyle=auto;strokeColor=none;fontColor=light-dark(#FFFFFF,#000000);fontStyle=1;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=none;spacing=0;" vertex="1" parent="legend-group">
          <mxGeometry x="20" y="271" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-5" value="The origin guard, a regional AWS WAF web ACL on the load balancer, blocks each request that lacks the header. AWS Secrets Manager holds the value." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);labelBackgroundColor=none;" vertex="1" parent="legend-group">
          <mxGeometry x="60" y="275" width="420" height="62" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=light-dark(#000000,#FFFFFF);fillStyle=auto;strokeColor=none;fontColor=light-dark(#FFFFFF,#000000);fontStyle=1;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=none;spacing=0;" vertex="1" parent="legend-group">
          <mxGeometry x="20" y="343" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-6" value="The Application Load Balancer sends the request to the FastAPI tasks on AWS Fargate (Arm64, 1 to 2 tasks)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);labelBackgroundColor=none;" vertex="1" parent="legend-group">
          <mxGeometry x="60" y="347" width="420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=light-dark(#000000,#FFFFFF);fillStyle=auto;strokeColor=none;fontColor=light-dark(#FFFFFF,#000000);fontStyle=1;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=none;spacing=0;" vertex="1" parent="legend-group">
          <mxGeometry x="20" y="397" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-7" value="The API looks for the result in the data bucket. On a miss, it computes the result and writes it once." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);labelBackgroundColor=none;" vertex="1" parent="legend-group">
          <mxGeometry x="60" y="401" width="420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=light-dark(#000000,#FFFFFF);fillStyle=auto;strokeColor=none;fontColor=light-dark(#FFFFFF,#000000);fontStyle=1;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=none;spacing=0;" vertex="1" parent="legend-group">
          <mxGeometry x="20" y="451" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-8" value="For a new result, the API reads NASA POWER (MERRA-2) Zarr chunks from the AWS Open Data bucket in the same Region, with no credentials." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);labelBackgroundColor=none;" vertex="1" parent="legend-group">
          <mxGeometry x="60" y="455" width="420" height="62" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-9" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=light-dark(#000000,#FFFFFF);fillStyle=auto;strokeColor=none;fontColor=light-dark(#FFFFFF,#000000);fontStyle=1;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=none;spacing=0;" vertex="1" parent="legend-group">
          <mxGeometry x="20" y="523" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-9" value="For the news tab, the API reads Google News RSS and GDELT DOC 2.0." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);labelBackgroundColor=none;" vertex="1" parent="legend-group">
          <mxGeometry x="60" y="527" width="420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-10" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=light-dark(#000000,#FFFFFF);fillStyle=auto;strokeColor=none;fontColor=light-dark(#FFFFFF,#000000);fontStyle=1;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=none;spacing=0;" vertex="1" parent="legend-group">
          <mxGeometry x="20" y="577" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-10" value="The API writes one log line per request: timings, bytes read and cache hits." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);labelBackgroundColor=none;" vertex="1" parent="legend-group">
          <mxGeometry x="60" y="581" width="420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-11" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=light-dark(#000000,#FFFFFF);fillStyle=auto;strokeColor=none;fontColor=light-dark(#FFFFFF,#000000);fontStyle=1;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;labelBackgroundColor=none;spacing=0;" vertex="1" parent="legend-group">
          <mxGeometry x="20" y="631" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-11" value="Before a release, the team runs the batch job on a laptop. Then the team syncs the results to the data bucket and the static export to the web bucket." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);labelBackgroundColor=none;" vertex="1" parent="legend-group">
          <mxGeometry x="60" y="635" width="420" height="62" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
